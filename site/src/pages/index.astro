---
import Base from '../layouts/Base.astro';
import Compare from '../components/Compare.astro';
import StageEntry from '../components/StageEntry.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import Conditions from '../components/Conditions.astro';
import Chart from '../components/Chart.astro';
import ClearNights from '../components/ClearNights.astro';
import FrameFunnel from '../components/FrameFunnel.astro';
import FocusDrift from '../components/FocusDrift.astro';
import charts from '../data/charts.json';
import { journal, isPlaceholder } from '../lib/journal';
import { todo } from '../lib/todo';

const REPO = 'https://github.com/acmck/m31-belfast';

if (isPlaceholder) {
  console.warn('\n[m31-belfast] journal.json still contains PLACEHOLDER values. Do not deploy this build.\n');
}

const stages = [...journal.stages].sort((a, b) => a.index - b.index);
const timeline = [...(journal.timeline ?? [])].sort((a, b) => a.index - b.index);
const hasTimeline = timeline.length > 0;
// Fallback hero: the lesson named by hero_stage_id, with first-light / latest labels.
const heroById = stages.find((s) => s.id === journal.hero_stage_id);
const heroStage = heroById ?? (journal.hero ? undefined : stages[stages.length - 1]);
// the hero is the first-light → latest pair, so it isn't repeated in the lessons
const listed = stages.filter((s) => s !== heroStage);
const firstNight = journal.nights.find((n) => n.id === heroStage?.night_ids[0]);
const heroPair = journal.hero ?? heroStage;
const heroLabels = journal.hero
  ? {}
  : {
      beforeLabel: `First light${firstNight ? `, ${firstNight.label}` : ''}`,
      afterLabel: heroStage ? `Latest: ${heroStage.after.label}` : undefined,
    };
const heroNote = journal.hero ? null : heroStage?.what_it_did;
const chartOrder = hasTimeline
  ? timeline.map((t) => ({ id: t.id, index: t.index }))
  : stages.map((s) => ({ id: s.id, index: s.index }));
const title = 'M31 from Belfast';
const description =
  'Learning how to capture M31 from rainy, Bortle 6 Belfast with a Seestar S30 Pro: every processing change, before and after.';
---
<Base title={title} description={description}>
  {isPlaceholder && (
    <p class="placeholder-banner" role="note">PLACEHOLDER DATA: this build uses test images and fake numbers.</p>
  )}
  <header class="masthead">
    <p class="wordmark">M31 / Belfast</p>
    <section class="todo log" aria-labelledby="h-todo">
      <h2 id="h-todo" class="todo-title">To do</h2>
      <ol>
        {todo.map((t) => <li>{t}</li>)}
      </ol>
    </section>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="h-hero">
      <h1 id="h-hero">Learning how to capture M31 from rainy, Bortle&nbsp;6 Belfast</h1>
      <p class="lede">
        I pointed a Seestar S30 Pro at the Andromeda Galaxy from Belfast, where the sky is Bortle 6 and most nights
        it rains.{hasTimeline
          ? ' Below is the best picture I had on each date since first light, then what each change did on its own.'
          : ' Below are the processing changes I made, one at a time, and what each one did to the picture.'}
      </p>
      {heroPair && (
        <figure class="hero-fig">
          <Compare stage={heroPair} priority sizes="(min-width: 1100px) 1040px, 100vw" {...heroLabels} />
        </figure>
      )}
      {heroNote && <p class="lede">{heroNote}</p>}
    </section>

    {hasTimeline && (
      <section class="journey timeline" aria-labelledby="h-timeline">
        <h2 id="h-timeline" class="section-title">Timeline</h2>
        <p class="lede">
          Each step is the best picture I had on that date, made with that date's frames and code. Before is the
          previous step, and frames and minutes are running totals. Steps that came out worse stay in, with a note on
          what went wrong. Drag the line, or tab to it and use the arrow keys.
        </p>
        {timeline.map((t) => <TimelineEntry step={t} />)}
        <p class="story-link"><a href="/story">Watch the stack grow, step by step →</a></p>
      </section>
    )}

    {listed.length > 0 && (
      <section class="journey lessons" aria-labelledby="h-journey">
        {hasTimeline ? (
          <>
            <h2 id="h-journey" class="section-title">What each change did</h2>
            <p class="lede">
              I reprocessed these today so each comparison isolates one change. Before is on the left and after is on
              the right, aligned on the same stars.
            </p>
          </>
        ) : (
          <>
            <h2 id="h-journey" class="section-title">Stages</h2>
            <p class="lede">
              Each stage changes one thing. Before is on the left and after is on the right, aligned on the same stars.
              Drag the line, or tab to it and use the arrow keys.
            </p>
          </>
        )}
        {listed.map((s) => <StageEntry stage={s} nights={journal.nights} />)}
      </section>
    )}

    <Conditions nights={journal.nights} />

    <section class="integration night-charts" aria-labelledby="h-clear">
      <h2 id="h-clear">Clear nights</h2>
      <p class="lede">Belfast's cloud for every night since I started. The dark squares are the clear ones.</p>
      <ClearNights data={charts.clear_nights} />
    </section>

    <section class="integration night-charts" aria-labelledby="h-frames">
      <h2 id="h-frames">Where the frames went</h2>
      <p class="lede">
        The scope skips some exposures and my QA throws out a few more. On the moonlit night a third of the slots
        never became frames.
      </p>
      <FrameFunnel funnel={charts.funnel} wind={charts.wind} corr={charts.wind_correlation} nights={journal.nights} />
    </section>

    <section class="integration night-charts" aria-labelledby="h-focus">
      <h2 id="h-focus">Focus through the night</h2>
      <p class="lede">On 7/8 Sep the stars grew all night while the focuser never moved. Autofocus mid-session is the fix I haven't tried yet.</p>
      <FocusDrift focus={charts.focus} nights={journal.nights} />
    </section>

    <section class="integration" aria-labelledby="h-chart">
      <h2 id="h-chart">Signal against time</h2>
      <p class="lede">
        With nothing else changed, signal-to-noise grows with the square root of time, which is the faint curve.
        Points under it lost something along the way. Points over it gained more from processing than the extra
        minutes alone would give.
      </p>
      <Chart
        points={journal.chart}
        order={chartOrder}
        noun={hasTimeline ? 'step' : 'stage'}
        firstLight={journal.hero?.before?.snr_headline != null ? { snr: journal.hero.before.snr_headline, label: journal.hero.before.label } : null}
      />
    </section>
  </main>

  <footer class="colophon">
    <p>Made with a ZWO Seestar S30 Pro.</p>
    <p>Processed with Siril, GraXpert, Dark Star and ASTAP.</p>
    <p>The pipeline and this site are on <a href={REPO}>GitHub</a>.</p>
    <p class="log fine">data generated {journal.generated.slice(0, 10)}</p>
  </footer>

  <script>
    import '../scripts/compare-slider.ts';
  </script>
</Base>
