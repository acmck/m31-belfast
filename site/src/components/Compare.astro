---
import Picture from './Picture.astro';
import { readout, type Stage } from '../lib/journal';

interface Props {
  stage: Stage;
  priority?: boolean;
  sizes?: string;
  beforeLabel?: string;
  afterLabel?: string;
}

const { stage, priority = false, sizes, beforeLabel, afterLabel } = Astro.props;
const { before, after, images } = stage;
const rb = readout(beforeLabel ? { ...before, label: beforeLabel } : before);
const ra = readout(afterLabel ? { ...after, label: afterLabel } : after);
const ratio = `${images.after.width} / ${images.after.height}`;
const beforeName = beforeLabel || before.label || 'before';
const afterName = afterLabel || after.label || 'after';
---
<compare-slider
  value="50"
  data-before={beforeName}
  data-after={afterName}
  style={`--ratio: ${ratio}`}
>
  <div
    class="cs-frame"
    style={priority && images.placeholder ? `background:center/cover url(${images.placeholder})` : undefined}
  >
    <div class="cs-layer cs-after">
      <Picture img={images.after} alt={`After: ${afterName}`} priority={priority} sizes={sizes} />
    </div>
    <div class="cs-layer cs-before">
      <Picture img={images.before} alt={`Before: ${beforeName}`} priority={priority} sizes={sizes} />
    </div>
    <div
      class="cs-handle"
      role="slider"
      tabindex="0"
      aria-label={`Compare ${beforeName} with ${afterName}`}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext={`50 percent ${beforeName} on the left, 50 percent ${afterName} on the right`}
    >
      <span class="cs-line" aria-hidden="true"></span>
      <span class="cs-read cs-read-before" aria-hidden="true">
        {rb.map((l) => <span>{l}</span>)}
      </span>
      <span class="cs-read cs-read-after" aria-hidden="true">
        {ra.map((l) => <span>{l}</span>)}
      </span>
    </div>
  </div>
  <dl class="cs-captions">
    <div class="cs-cap cs-cap-before">
      <dt>Before (left)</dt>
      {rb.map((l) => <dd>{l}</dd>)}
    </div>
    <div class="cs-cap cs-cap-after">
      <dt>After (right)</dt>
      {ra.map((l) => <dd>{l}</dd>)}
    </div>
  </dl>
</compare-slider>
