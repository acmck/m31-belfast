---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en" data-light="normal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#211f1c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Red light before first paint, so the page never flashes bright in the garden.
      (function () {
        var on = false;
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('red')) on = q.get('red') !== '0';
          else on = localStorage.getItem('red-light') === '1';
        } catch (e) {}
        if (on) {
          document.documentElement.dataset.light = 'red';
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#000000');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
